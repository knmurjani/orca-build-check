+        "http_status_class": "NOT_PROVIDED"
+    }));
+    let transport = ExecErrorObservation::from_info(Some(&CodexErrorInfo::HttpConnectionFailed {
+        http_status_code: Some(429),
+    }), None, codex_exec::ExecErrorOrigin::DirectFailedTurn);
+    assert_eq!(serde_json::to_value(transport).unwrap(), json!({
+        "version": 1, "category": "TRANSPORT", "notification_will_retry": null, "origin": "DIRECT_FAILED_TURN",
+        "http_status_class": "CLIENT_ERROR"
