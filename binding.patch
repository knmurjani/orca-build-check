+"""Canonical Exec JSONL demultiplexer, pure bounded chunk input.
+Only exact canonical diagnostic prefix is parsed/stored. Legacy lines skipped bytewise.
+Not a process supervisor. Caller must tick while waiting, bound pipe reads, verify
+process/artifact/EOF and discard stderr. No time-based interruption of stuck caller.
+"""
+import math
+from binding_receipt import Receipt
+PREFIX=b'{"type":"diagnostic.binding",'
+class BindingStream:
+    def __init__(self,now,*,lifetime_seconds,max_bytes):
+        if type(now) not in (int,float) or not math.isfinite(now):raise ValueError('CLOCK')
+        if type(lifetime_seconds) not in (int,float) or not math.isfinite(lifetime_seconds) or not 0<lifetime_seconds<=86400:raise ValueError('ENVELOPE')
+        if type(max_bytes) is not int or not 0<max_bytes<=16*1024*1024*1024:raise ValueError('ENVELOPE')
+        self.lifetime_seconds=lifetime_seconds;self.max_bytes=max_bytes
+        self.receipt=Receipt();self.start=now;self.last=now;self.since=None
+        self.mode='PREFIX';self.buffer=bytearray();self.total=0;self.closed=False;self.refused=False
+    def refuse(self):
+        self.buffer.clear();self.refused=True;self.closed=True
+        self.receipt.state='REFUSED';self.receipt.complete=False;self.receipt.errors=[];self.receipt.terminal=None;self.receipt.end=None
+    def tick(self,now):
+        if self.closed:return
+        if type(now) not in (int,float) or not math.isfinite(now) or now<self.last or now-self.start>=self.lifetime_seconds or (self.since is not None and now-self.since>=30):self.refuse();return
+        self.last=now
+    def feed(self,chunk,now):
+        if self.closed:return
+        self.tick(now)
+        if self.closed:return
+        if type(chunk) is not bytes or len(chunk)>65536:self.refuse();return
+        self.total+=len(chunk)
+        if self.total>self.max_bytes:self.refuse();return
+        # At most prefix bytes for skipped line,16KiB for diagnostic line.
+        for b in chunk:
+            if self.since is None:self.since=now
+            if b==10:
+                if self.mode=='DIAGNOSTIC':
+                    self.receipt.feed(bytes(self.buffer)+b'\n')
+                    if self.receipt.state=='REFUSED':self.refuse();return
+                elif self.mode=='PREFIX' and self.buffer:
+                    # Partial canonical prefix at line end is malformed/unknown.
+                    self.refuse();return
+                self.buffer.clear();self.mode='PREFIX';self.since=None
+            elif self.mode=='SKIP':continue
+            else:
+                self.buffer.append(b)
+                if self.mode=='PREFIX':
+                    if not PREFIX.startswith(self.buffer):self.buffer.clear();self.mode='SKIP'
+                    elif len(self.buffer)==len(PREFIX):self.mode='DIAGNOSTIC'
+                elif len(self.buffer)>16384:self.refuse();return
+    def finish(self,now):
+        if not self.closed:
+            # EOF delivery can be delayed after a complete end receipt. Do not
+            # erase an already-ended observation only because EOF arrived later.
+            # Clock validity still matters; byte/line errors remain fatal.
+            if self.receipt.state=='ENDED' and self.since is None:
+                if type(now) not in (int,float) or not math.isfinite(now) or now<self.last:self.refuse()
+            else:self.tick(now)
+            # Any unterminated line, including skipped legacy, means truncated stream.
+            if not self.closed and self.since is not None:self.refuse()
+            self.closed=True
+        return self.receipt.finish()
