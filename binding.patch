+        info: Option<&codex_app_server_protocol::CodexErrorInfo>,
+        notification_will_retry: Option<bool>,
+        origin: ExecErrorOrigin,
+    ) -> Self {
+        use codex_app_server_protocol::CodexErrorInfo as Info;
+        use ExecErrorCategory as Category;
+        let (category, status) = match info {
+            Some(Info::Unauthorized) => (Category::Authentication, None),
+            Some(Info::HttpConnectionFailed { http_status_code })
+            | Some(Info::ResponseStreamConnectionFailed { http_status_code })
+            | Some(Info::ResponseStreamDisconnected { http_status_code })
+            | Some(Info::ResponseTooManyFailedAttempts { http_status_code }) => {
+                (Category::Transport, *http_status_code)
+            }
+            Some(Info::SessionBudgetExceeded)
+            | Some(Info::UsageLimitExceeded)
+            | Some(Info::RateLimitExceeded)
+            | Some(Info::FlexUnavailable)
+            | Some(Info::ServerOverloaded)
+            | Some(Info::PolicyCapacityUnavailable) => (Category::Capacity, None),
+            Some(Info::ContextWindowExceeded) => (Category::Context, None),
+            Some(Info::InferenceHookDenied)
+            | Some(Info::CyberPolicy)
+            | Some(Info::MisalignmentPolicyViolation)
+            | Some(Info::TooManyDenials) => (Category::Policy, None),
+            Some(Info::SandboxError) => (Category::Sandbox, None),
+            Some(Info::BadRequest)
+            | Some(Info::ModelNotFound)
+            | Some(Info::ActiveTurnNotSteerable { .. }) => (Category::Input, None),
+            Some(Info::InternalServerError) => (Category::InternalServer, None),
+            Some(Info::ThreadRollbackFailed) => (Category::Rollback, None),
+            Some(Info::Other) => (Category::Other, None),
+            None => (Category::Missing, None),
+            #[allow(unreachable_patterns)]
+            _ => (Category::Unknown, None),
+        };
+        let http_status_class = match status {
+            None => ExecHttpStatusClass::NotProvided,
+            Some(100..=199) => ExecHttpStatusClass::Informational,
+            Some(200..=299) => ExecHttpStatusClass::Success,
+            Some(300..=399) => ExecHttpStatusClass::Redirect,
+            Some(400..=499) => ExecHttpStatusClass::ClientError,
+            Some(500..=599) => ExecHttpStatusClass::ServerError,
+            Some(_) => ExecHttpStatusClass::Unknown,
+        };
+        Self {
+            version: 1,
+            category,
+            origin,
+            notification_will_retry,
+            http_status_class,
+        }
+    }
 }
 
