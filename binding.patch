+    def snapshot(self):
+        return {'schema':'orca.exec-binding-receipt.v1','state':self.state,'loop_observation_complete':getattr(self,'complete',False),'errors':[dict(x) for x in self.errors],'terminal':None if self.terminal is None else {'status':self.terminal['status'],'direct_error':None if self.terminal['direct_error'] is None else dict(self.terminal['direct_error'])},'end':None if self.end is None else dict(self.end),'native_success':False,'admission_changed':False}
