+//! Observation only. Never drives admission, retry, lifecycle, or exit status.
+//! IDs stay private; scope 1 is local to one fresh Exec process, never resumable.
+use codex_app_server_protocol::{ServerNotification, TurnStatus};
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+use crate::exec_events::{ExecErrorObservation, ExecErrorOrigin};
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, TS)]
+#[serde(tag = "stage", rename_all = "snake_case")]
+pub enum ExecBindingObservation {
+    SetupStarted { version: u8 },
+    TurnBound { scope: u8 },
+    CurrentError { scope: u8, ordinal: u32, observation: ExecErrorObservation },
+    Terminal { scope: u8, status: ObservedTerminal, direct_error: Option<ExecErrorObservation> },
+    StreamEnded { scope: u8, terminal_seen: bool, lag_seen: bool, duplicate_terminal_seen: bool, post_terminal_error_seen: bool, shutdown_ok: bool },
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, TS)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum ObservedTerminal { Completed, Failed, Interrupted, Other }
+
+/// Created only AFTER turn/start returned the active ID. Does not observe requests.
+/// No comparison outcome alters existing should_process_notification behavior.
+pub(crate) struct ExecBindingCapture {
+    thread_id: String,
+    turn_id: String,
+    error_ordinal: u32,
+    terminal_seen: bool,
+    lag_seen: bool,
+    duplicate_terminal_seen: bool,
+    post_terminal_error_seen: bool,
+}
+impl ExecBindingCapture {
+    pub(crate) fn new(thread_id: String, turn_id: String) -> Self {
+        Self { thread_id, turn_id, error_ordinal: 0, terminal_seen: false, lag_seen: false, duplicate_terminal_seen: false, post_terminal_error_seen: false }
+    }
+    pub(crate) fn observe(&mut self, notification: &ServerNotification) -> Option<ExecBindingObservation> {
+        match notification {
+            ServerNotification::Error(n) if n.thread_id == self.thread_id && n.turn_id == self.turn_id => {
+                if self.terminal_seen { self.post_terminal_error_seen = true; return None; }
+                // Saturation is an incomplete observation, never a wrapped identity.
+                let Some(next) = self.error_ordinal.checked_add(1) else { self.lag_seen = true; return None; };
+                self.error_ordinal = next;
+                Some(ExecBindingObservation::CurrentError { scope: 1, ordinal: next, observation: ExecErrorObservation::from_info(n.error.codex_error_info.as_ref(), Some(n.will_retry), ExecErrorOrigin::CurrentNotification) })
+            }
+            ServerNotification::TurnCompleted(n) if n.thread_id == self.thread_id && n.turn.id == self.turn_id => {
+                if self.terminal_seen { self.duplicate_terminal_seen = true; return None; }
+                self.terminal_seen = true;
+                let status = match n.turn.status { TurnStatus::Completed => ObservedTerminal::Completed, TurnStatus::Failed => ObservedTerminal::Failed, TurnStatus::Interrupted => ObservedTerminal::Interrupted, _ => ObservedTerminal::Other };
+                Some(ExecBindingObservation::Terminal { scope: 1, status, direct_error: n.turn.error.as_ref().map(|e| ExecErrorObservation::from_info(e.codex_error_info.as_ref(), None, ExecErrorOrigin::DirectFailedTurn)) })
+            }
+            _ => None,
+        }
+    }
+    pub(crate) fn lagged(&mut self) { self.lag_seen = true; }
+    /// Says what the loop observed, not transport completeness, auth, model success,
+    /// tool success, independent admission acceptance, or persistence durability.
+    pub(crate) fn finish(self, shutdown_ok: bool) -> ExecBindingObservation {
+        ExecBindingObservation::StreamEnded { scope: 1, terminal_seen: self.terminal_seen, lag_seen: self.lag_seen, duplicate_terminal_seen: self.duplicate_terminal_seen, post_terminal_error_seen: self.post_terminal_error_seen, shutdown_ok }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_app_server_protocol::{CodexErrorInfo, ErrorNotification, TurnError};
+    fn error(thread: &str, turn: &str) -> ServerNotification {
+        ServerNotification::Error(ErrorNotification { thread_id: thread.into(), turn_id: turn.into(), will_retry: false, error: TurnError { message: "secret message".into(), additional_details: Some("secret detail".into()), codex_error_info: Some(CodexErrorInfo::Unauthorized), misalignment: None } })
+    }
+    fn terminal(thread: &str, turn: &str, direct: bool) -> ServerNotification {
+        use codex_app_server_protocol::{Turn, TurnCompletedNotification, TurnItemsView};
+        ServerNotification::TurnCompleted(TurnCompletedNotification { thread_id: thread.into(), turn: Turn {
+            id: turn.into(), root_turn_id: None, items_view: TurnItemsView::Full, items: Vec::new(), status: TurnStatus::Failed,
+            error: if direct { Some(TurnError { message: "terminal secret".into(), additional_details: None, codex_error_info: Some(CodexErrorInfo::SandboxError), misalignment: None }) } else { None },
+            started_at: None, completed_at: None, duration_ms: None,
+        } })
+    }
+    #[test]
+    fn terminal_is_direct_only_and_exact() {
+        let mut c=ExecBindingCapture::new("t".into(),"u".into());
+        c.observe(&error("t","u"));
+        assert_eq!(c.observe(&terminal("t","other",true)),None);
+        assert!(matches!(c.observe(&terminal("t","u",false)),Some(ExecBindingObservation::Terminal { direct_error:None,.. })));
+        assert!(matches!(c.finish(true),ExecBindingObservation::StreamEnded { terminal_seen:true,.. }));
+    }
+    #[test]
+    fn duplicate_and_post_terminal_are_flagged_not_attributed() {
+        let mut c=ExecBindingCapture::new("t".into(),"u".into());
+        let n=c.observe(&terminal("t","u",true)).unwrap();
+        let text=serde_json::to_string(&n).unwrap();
+        assert!(!text.contains("terminal secret"));assert!(text.contains("DIRECT_FAILED_TURN"));
+        assert_eq!(c.observe(&terminal("t","u",true)),None);
+        assert_eq!(c.observe(&error("t","u")),None);
+        assert!(matches!(c.finish(true),ExecBindingObservation::StreamEnded { duplicate_terminal_seen:true,post_terminal_error_seen:true,.. }));
+    }
+    #[test]
+    fn ordinal_does_not_wrap() {
+        let mut c=ExecBindingCapture::new("t".into(),"u".into());c.error_ordinal=u32::MAX;
+        assert_eq!(c.observe(&error("t","u")),None);
+        assert!(matches!(c.finish(true),ExecBindingObservation::StreamEnded { lag_seen:true,.. }));
+    }
+    #[test]
+    fn exact_both_ids_required() {
+        let mut c=ExecBindingCapture::new("private-thread".into(),"private-turn".into());
+        assert_eq!(c.observe(&error("wrong","private-turn")),None);
+        assert_eq!(c.observe(&error("private-thread","wrong")),None);
+        let event=c.observe(&error("private-thread","private-turn")).unwrap();
+        let text=serde_json::to_string(&event).unwrap();
+        assert!(!text.contains("private-"));assert!(!text.contains("secret"));
+        assert!(text.contains("AUTHENTICATION"));assert!(text.contains("CURRENT_NOTIFICATION"));
+    }
+    #[test]
+    fn eof_without_terminal_is_not_success() {
+        let c=ExecBindingCapture::new("t".into(),"u".into());
+        assert!(matches!(c.finish(true),ExecBindingObservation::StreamEnded { terminal_seen:false,.. }));
+    }
+    #[test]
+    fn lag_and_shutdown_are_independent() {
+        let mut c=ExecBindingCapture::new("t".into(),"u".into());c.lagged();
+        assert!(matches!(c.finish(false),ExecBindingObservation::StreamEnded { lag_seen:true,shutdown_ok:false,.. }));
+    }
+    #[test]
+    fn actual_serde_jsonl_roundtrips_through_python_reader() {
+        use std::io::Write;
+        use std::process::{Command, Stdio};
+        use crate::exec_events::ThreadEvent;
+        let mut capture=ExecBindingCapture::new("private-thread".into(),"private-turn".into());
+        let events=vec![
+            ExecBindingObservation::SetupStarted { version:1 },
+            ExecBindingObservation::TurnBound { scope:1 },
+            capture.observe(&error("private-thread","private-turn")).unwrap(),
+            capture.observe(&terminal("private-thread","private-turn",false)).unwrap(),
+            capture.finish(true),
+        ];
+        let script=std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../binding_roundtrip.py");
+        let mut child=Command::new("python3").arg(script).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn().expect("python3 required for actual Rust-to-reader test");
+        {
+            let input=child.stdin.as_mut().unwrap();
+            for event in events {
+                let encoded=serde_json::to_vec(&ThreadEvent::DiagnosticBinding(event)).unwrap();
+                input.write_all(&encoded).unwrap();input.write_all(b"\n").unwrap();
+            }
+        }
+        drop(child.stdin.take());
+        let output=child.wait_with_output().unwrap();
+        assert!(output.status.success(),"Rust-to-reader validation failed");
+    }
+
+}
