+/** Closed observation payload. Not a retry or admission instruction. */
+export type ExecErrorObservation = {
+  version: number;
+  category: "AUTHENTICATION" | "TRANSPORT" | "CAPACITY" | "CONTEXT" | "POLICY" | "SANDBOX" | "INPUT" | "INTERNAL_SERVER" | "ROLLBACK" | "OTHER" | "MISSING" | "UNKNOWN";
+  origin: "CURRENT_NOTIFICATION" | "DIRECT_FAILED_TURN";
+  notification_will_retry: boolean | null;
+  http_status_class: "INFORMATIONAL" | "SUCCESS" | "REDIRECT" | "CLIENT_ERROR" | "SERVER_ERROR" | "NOT_PROVIDED" | "UNKNOWN";
+};
+/** Prompt-mode process-local loop observations, never tool/model success. */
+export type ExecBindingObservation =
+  | { stage: "setup_started"; version: number }
+  | { stage: "turn_bound"; scope: number }
+  | { stage: "current_error"; scope: number; ordinal: number; observation: ExecErrorObservation }
+  | { stage: "terminal"; scope: number; status: "COMPLETED" | "FAILED" | "INTERRUPTED" | "OTHER"; direct_error: ExecErrorObservation | null }
+  | { stage: "stream_ended"; scope: number; terminal_seen: boolean; lag_seen: boolean; duplicate_terminal_seen: boolean; post_terminal_error_seen: boolean; shutdown_ok: boolean };
+export type DiagnosticBindingEvent = { type: "diagnostic.binding" } & ExecBindingObservation;
