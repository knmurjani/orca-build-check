+    let missing = ExecErrorObservation::from_info(
+        None,
+        None,
+        codex_exec::ExecErrorOrigin::DirectFailedTurn,
+    );
+    assert_eq!(serde_json::to_value(missing).unwrap(), json!({
+        "version": 1, "category": "MISSING", "notification_will_retry": null, "origin": "DIRECT_FAILED_TURN",
+        "http_status_class": "NOT_PROVIDED"
+    }));
