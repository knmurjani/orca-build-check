+"""Pure bounded receipt parser. No I/O, process launch, clock, or admission.
+Feed already-bounded complete JSONL lines. Caller must bound reads/time/memory,
+discard stderr and legacy stdout without logs, verify EOF/process/artifact binding,
+and never treat this receipt as tool/model success. No raw input retained here.
+"""
+import json
+MAX_LINE=1024*1024
+MAX_BYTES=16*1024*1024
+MAX_LINES=10000
+CATEGORIES=set('AUTHENTICATION TRANSPORT CAPACITY CONTEXT POLICY SANDBOX INPUT INTERNAL_SERVER ROLLBACK OTHER MISSING UNKNOWN'.split())
+STATUSES=set('INFORMATIONAL SUCCESS REDIRECT CLIENT_ERROR SERVER_ERROR NOT_PROVIDED UNKNOWN'.split())
+def pairs(items):
+    out={}
+    for k,v in items:
+        if k in out: raise ValueError()
+        out[k]=v
+    return out
+def constant(_): raise ValueError()
+def closed_obs(x, origin):
+    if type(x) is not dict or set(x)!={'version','category','origin','notification_will_retry','http_status_class'}: raise ValueError()
+    if type(x['version']) is not int or x['version']!=1: raise ValueError()
+    if type(x['category']) is not str or x['category'] not in CATEGORIES: raise ValueError()
+    if x['origin']!=origin: raise ValueError()
+    retry=x['notification_will_retry']
+    if origin=='CURRENT_NOTIFICATION':
+        if type(retry) is not bool: raise ValueError()
+    elif retry is not None: raise ValueError()
+    if type(x['http_status_class']) is not str or x['http_status_class'] not in STATUSES: raise ValueError()
+    if x['category']!='TRANSPORT' and x['http_status_class']!='NOT_PROVIDED': raise ValueError()
+    return dict(x)
+class Receipt:
+    def __init__(self):
+        self.state='EMPTY';self.lines=0;self.bytes=0;self.errors=[];self.terminal=None;self.end=None
+    def feed(self,line):
+        try:
+            if self.state in ('REFUSED','EOF'): raise ValueError()
+            if type(line) is not bytes or len(line)>MAX_LINE or not line.endswith(b'\n') or b'\n' in line[:-1]: raise ValueError()
+            self.lines+=1;self.bytes+=len(line)
+            if self.lines>MAX_LINES or self.bytes>MAX_BYTES: raise ValueError()
+            text=line.decode('utf8',errors='strict')
+            if text.startswith('\ufeff') or '\x00' in text: raise ValueError()
+            x=json.loads(text,object_pairs_hook=pairs,parse_constant=constant)
+            if type(x) is not dict or type(x.get('type')) is not str: raise ValueError()
+            if x['type']!='diagnostic.binding': return
+            stage=x.get('stage')
+            keys={'setup_started':{'version'},'turn_bound':{'scope'},'current_error':{'scope','ordinal','observation'},'terminal':{'scope','status','direct_error'},'stream_ended':{'scope','terminal_seen','lag_seen','duplicate_terminal_seen','post_terminal_error_seen','shutdown_ok'}}
+            if type(stage) is not str or stage not in keys or set(x)!={'type','stage'}|keys[stage]: raise ValueError()
+            if stage!='setup_started' and (type(x['scope']) is not int or x['scope']!=1): raise ValueError()
+            if stage=='setup_started':
+                if self.state!='EMPTY' or type(x['version']) is not int or x['version']!=1: raise ValueError()
+                self.state='SETUP'
+            elif stage=='turn_bound':
+                if self.state!='SETUP': raise ValueError()
+                self.state='ACTIVE'
+            elif stage=='current_error':
+                if self.state!='ACTIVE' or type(x['ordinal']) is not int or x['ordinal']!=len(self.errors)+1: raise ValueError()
+                self.errors.append(closed_obs(x['observation'],'CURRENT_NOTIFICATION'))
+            elif stage=='terminal':
+                if self.state!='ACTIVE' or type(x['status']) is not str or x['status'] not in {'COMPLETED','FAILED','INTERRUPTED','OTHER'}: raise ValueError()
+                self.terminal={'status':x['status'],'direct_error':None if x['direct_error'] is None else closed_obs(x['direct_error'],'DIRECT_FAILED_TURN')}
