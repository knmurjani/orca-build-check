+#[test]
+fn cached_retry_is_historical_and_direct_failure_has_no_retry_flag() {
+    use codex_exec::{ExecErrorCategory, ExecErrorOrigin};
+    let mut processor = EventProcessorWithJsonOutput::new(None);
+    processor.collect_thread_events(ServerNotification::Error(ErrorNotification {
+        error: TurnError {
+            misalignment: None,
+            message: "transient".to_string(),
+            codex_error_info: Some(codex_app_server_protocol::CodexErrorInfo::Unauthorized),
+            additional_details: None,
+        },
+        will_retry: true,
+        thread_id: "thread-1".to_string(),
+        turn_id: "turn-1".to_string(),
+    }));
+    for direct in [false, true] {
+        let collected = processor.collect_thread_events(ServerNotification::TurnCompleted(
+            TurnCompletedNotification {
+                thread_id: "thread-1".to_string(),
+                turn: Turn {
+                    id: "turn-1".to_string(),
+                    root_turn_id: None,
+                    items_view: codex_app_server_protocol::TurnItemsView::Full,
+                    items: Vec::new(),
+                    status: TurnStatus::Failed,
+                    error: if direct { Some(TurnError {
+                        misalignment: None,
+                        message: "final".to_string(),
+                        codex_error_info: Some(codex_app_server_protocol::CodexErrorInfo::InternalServerError),
+                        additional_details: None,
+                    }) } else { None },
+                    started_at: None,
+                    completed_at: None,
+                    duration_ms: None,
+                },
+            },
+        ));
+        let ThreadEvent::TurnFailed(failed) = &collected.events[0] else {
+            panic!("expected failure")
+        };
+        if direct {
+            let observation = failed.error.observation.as_ref().unwrap();
+            assert_eq!(observation.origin, ExecErrorOrigin::DirectFailedTurn);
+            assert_eq!(observation.category, ExecErrorCategory::InternalServer);
+            assert_eq!(observation.notification_will_retry, None);
+        } else {
+            assert_eq!(failed.error.observation, None);
+        }
+    }
 }
 
