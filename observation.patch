+// Source candidate only: these Rust tests have not been compiled or executed.
+#[test]
+fn closed_observation_projection_excludes_payloads() {
+    use codex_app_server_protocol::CodexErrorInfo;
+    use codex_exec::ExecErrorObservation;
+    let auth = ExecErrorObservation::from_info(
+        Some(&CodexErrorInfo::Unauthorized),
+        Some(false),
+        codex_exec::ExecErrorOrigin::CurrentNotification,
+    );
+    assert_eq!(serde_json::to_value(auth).unwrap(), json!({
+        "version": 1, "category": "AUTHENTICATION", "notification_will_retry": false, "origin": "CURRENT_NOTIFICATION",
+        "http_status_class": "NOT_PROVIDED"
+    }));
+    let transport = ExecErrorObservation::from_info(Some(&CodexErrorInfo::HttpConnectionFailed {
+        http_status_code: Some(429),
+    }), None, codex_exec::ExecErrorOrigin::DirectFailedTurn);
+    assert_eq!(serde_json::to_value(transport).unwrap(), json!({
+        "version": 1, "category": "TRANSPORT", "notification_will_retry": null, "origin": "DIRECT_FAILED_TURN",
+        "http_status_class": "CLIENT_ERROR"
+    }));
+    let missing = ExecErrorObservation::from_info(
+        None,
+        None,
+        codex_exec::ExecErrorOrigin::DirectFailedTurn,
+    );
+    assert_eq!(serde_json::to_value(missing).unwrap(), json!({
+        "version": 1, "category": "MISSING", "notification_will_retry": null, "origin": "DIRECT_FAILED_TURN",
+        "http_status_class": "NOT_PROVIDED"
+    }));
+}
