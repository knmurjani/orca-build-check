+#[test]
+fn closed_observation_rejects_invalid_status_precision() {
+    use codex_app_server_protocol::CodexErrorInfo;
+    use codex_exec::{ExecErrorObservation, ExecHttpStatusClass};
+    for code in [0, 99, 600, 65535] {
+        let observation = ExecErrorObservation::from_info(Some(&CodexErrorInfo::HttpConnectionFailed {
+            http_status_code: Some(code),
+        }), Some(true), codex_exec::ExecErrorOrigin::CurrentNotification);
+        assert_eq!(observation.http_status_class, ExecHttpStatusClass::Unknown);
+    }
+}
